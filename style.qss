/* ==========================================================================
   StyleGAN Face Generator — Application Stylesheet
   Theme: Dark gray + blue accent
   Edit this file to customise the look without touching app.py
   ========================================================================== */

/* ---------- Window & root panels ---------------------------------------- */

QMainWindow, QWidget#root {
    background-color: #1e1e1e;
}

QWidget#sidebar {
    background-color: #2b2b2b;
    border-right: 1px solid #3a3a3a;
}

QWidget#preview_area {
    background-color: #1a1a1a;
}

/* ---------- Labels -------------------------------------------------------- */

QLabel {
    color: #d4d4d4;
    font-size: 13px;
    font-family: 'Segoe UI', sans-serif;
    background: transparent;
}

QLabel#app_title {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

QLabel#section_title {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
}

QLabel#field_label {
    color: #aaaaaa;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
    font-weight: bold;
}

QLabel#path_label {
    color: #888888;
    font-size: 11px;
    font-family: 'Segoe UI', sans-serif;
    background-color: #3c3f41;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 8px;
}

QLabel#status_label {
    color: #888888;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
}

QLabel#preview_placeholder {
    color: #444444;
    font-size: 14px;
    font-family: 'Segoe UI', sans-serif;
}

/* ---------- Divider ------------------------------------------------------- */

QFrame#divider {
    background-color: #3a3a3a;
    max-height: 1px;
    min-height: 1px;
}

/* ---------- SpinBox ------------------------------------------------------- */

QSpinBox {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 13px;
    font-family: 'Segoe UI', sans-serif;
    min-height: 28px;
}
QSpinBox:focus {
    border: 1px solid #2196F3;
}
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #4a4a4a;
    width: 18px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #2196F3;
}

/* ---------- ComboBox ------------------------------------------------------ */

QComboBox {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px 10px;
    font-size: 13px;
    font-family: 'Segoe UI', sans-serif;
    min-height: 28px;
}
QComboBox:hover {
    border: 1px solid #2196F3;
}
QComboBox:focus {
    border: 1px solid #42A5F5;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #888888;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555555;
    selection-background-color: #2196F3;
    selection-color: #ffffff;
    padding: 2px;
}

/* ---------- Buttons ------------------------------------------------------- */

QPushButton#gen_btn {
    background-color: #2196F3;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    font-size: 13px;
    font-weight: bold;
    font-family: 'Segoe UI', sans-serif;
    min-height: 38px;
}
QPushButton#gen_btn:hover    { background-color: #42A5F5; }
QPushButton#gen_btn:pressed  { background-color: #1565C0; }
QPushButton#gen_btn:disabled { background-color: #404040; color: #666666; }

QPushButton#browse_btn {
    background-color: #424242;
    color: #2196F3;
    border: 1px solid #555555;
    border-radius: 4px;
    font-size: 12px;
    font-family: 'Segoe UI', sans-serif;
    min-height: 26px;
    padding: 2px 10px;
}
QPushButton#browse_btn:hover {
    background-color: #4a4a4a;
    border: 1px solid #2196F3;
    color: #64B5F6;
}

/* ---------- Progress bar -------------------------------------------------- */

QProgressBar {
    background-color: #3a3a3a;
    border: none;
    border-radius: 3px;
    min-height: 5px;
    max-height: 5px;
}
QProgressBar::chunk {
    background-color: #2196F3;
    border-radius: 3px;
}
